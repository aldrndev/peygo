# Environment Variables
# Copy this file to .env.local and fill in the values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pivot Payment (Sandbox)
PIVOT_API_URL=https://api-stg.pivot-payment.com
PIVOT_API_KEY=
PIVOT_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pivot Payment (Payment Gateway)
# Dapatkan dari dashboard Pivot (Sandbox/Production)
PIVOT_API_KEY=
PIVOT_API_URL=https://api-stg.pivot-payment.com
PIVOT_WEBHOOK_SECRET=

# Resend (Email Service)
# Dapatkan dari resend.com
RESEND_API_KEY=

# App URL (Production URL)
NEXT_PUBLIC_APP_URL=https://peygo.id
